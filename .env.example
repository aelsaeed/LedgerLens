# Copy this file to .env for local development. Do not commit real invoice data or secrets.

# OCR language installed in Tesseract. The container ships with English data.
LEDGERLENS_OCR_LANG=eng

# Abort an OCR subprocess after this many seconds (1-120).
LEDGERLENS_OCR_TIMEOUT_SECONDS=15

# Request and decompressed-image safety limits.
LEDGERLENS_MAX_UPLOAD_BYTES=10485760
LEDGERLENS_MAX_IMAGE_PIXELS=25000000

# Raw invoice text can contain sensitive data; opt in only when it is needed.
LEDGERLENS_EXPOSE_RAW_TEXT=false

# Host port used by compose.yaml. This is not an application setting.
LEDGERLENS_PORT=8000
